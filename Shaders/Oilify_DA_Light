#include "ReShade.fxh"

/*
	Oilify Shader for ReShade
	
	Originally by: Lord of Lunacy
	
	This shader applies a Kuwahara filter using an optimized method for extracting the image mean and variance.
	
	Kuwahara filter. (2020, May 01). Retrieved October 17, 2020, from https://en.wikipedia.org/wiki/Kuwahara_filter
	
	Kyprianidis, J. E., Kang, H., &amp; Dã¶Llner, J. (2009). Image and Video Abstraction by Anisotropic Kuwahara Filtering.
	Computer Graphics Forum, 28(7), 1955-1963. doi:10.1111/j.1467-8659.2009.01574.x
*/
#ifndef OILIFY_SIZE
	#define OILIFY_SIZE 7
#endif
#ifndef OILIFY_ITERATIONS
	#define OILIFY_ITERATIONS 1
#endif
#define OILIFY_PASS \
		pass \
		{ \
			VertexShader = PostProcessVS;\
			PixelShader = KuwaharaPS;\
			RenderTarget0 = OilifyResult;\
		}\
	
	static const float PI = 3.1415926536;
	static const float GAUSSIAN_WEIGHTS[5] = {0.095766,	0.303053,	0.20236,	0.303053,	0.095766};
	static const float GAUSSIAN_OFFSETS[5] = {-3.2979345488, -1.40919905099, 0, 1.40919905099, 3.2979345488};
	
namespace Oilify
{
	texture BackBuffer : COLOR;
	texture OilifyInput {Width = BUFFER_WIDTH; Height = BUFFER_HEIGHT; Format = RGBA8;};
	texture Anisotropy {Width = BUFFER_WIDTH; Height = BUFFER_HEIGHT; Format = RGBA16f;};
	texture OriginalInput < pooled = true; >
	{
		Width = BUFFER_WIDTH;
		Height = BUFFER_HEIGHT;
		Format = RGBA16f;
	};
	texture OilifyResult < pooled = true; >
	{
		Width = BUFFER_WIDTH;
		Height = BUFFER_HEIGHT;
		Format = RGBA16f;
	};

	// Low-resolution persistent cache for the static, screen-space canvas relief.
	// A/B ping-pong keeps the last generated map available between refreshes.
	texture CanvasCacheA < pooled = true; >
	{
		Width = BUFFER_WIDTH / 4;
		Height = BUFFER_HEIGHT / 4;
		Format = RGBA8;
	};
	texture CanvasCacheB < pooled = true; >
	{
		Width = BUFFER_WIDTH / 4;
		Height = BUFFER_HEIGHT / 4;
		Format = RGBA8;
	};

	texture2D DepthBufferTex : DEPTH;

	sampler sBackBuffer{Texture = BackBuffer;};
	sampler sOilifyInput{Texture = OilifyInput;};
	sampler sAnisotropy{Texture = Anisotropy;};
	sampler sOriginalInput{Texture = OriginalInput; MagFilter = LINEAR; MinFilter = LINEAR; MipFilter = LINEAR;};
	sampler sOilifyResult{Texture = OilifyResult;};
	sampler sDepthBuffer{Texture = DepthBufferTex; MagFilter = POINT; MinFilter = POINT; MipFilter = POINT;};

	sampler sCanvasCacheA{Texture = CanvasCacheA; MagFilter = LINEAR; MinFilter = LINEAR; MipFilter = LINEAR;};
	sampler sCanvasCacheB{Texture = CanvasCacheB; MagFilter = LINEAR; MinFilter = LINEAR; MipFilter = LINEAR;};

	uniform bool HasDepth < source = "bufready_depth"; hidden = true; >;

	uniform int CanvasFrameCount < source = "framecount"; hidden = true; >;

	// Canvas is static in screen space, so expensive generation only runs every 8th frame.
	// Between refreshes the quarter-resolution cache is copied, which is much cheaper.
	#define CANVAS_UPDATE_INTERVAL 8


	uniform bool EnablePosterization<
		ui_type = "checkbox";
		ui_label = "Enable Posterization";
	> = false;

	uniform float PosterizationLevels<
		ui_type = "slider";
		ui_label = "Posterization Levels";
		ui_min = 2; ui_max = 32; ui_step = 1;
	> = 12;

	uniform bool EnableCanvas<
		ui_type = "checkbox";
		ui_label = "Enable Canvas Texture";
	> = false;

	uniform float CanvasStrength<
		ui_type = "slider";
		ui_label = "Canvas Strength";
		ui_min = 0; ui_max = 1; ui_step = 0.01;
	> = 0.20;

	uniform float CanvasScale<
		ui_type = "slider";
		ui_label = "Canvas Scale";
		ui_tooltip = "Controls how large the canvas weave appears. Higher values show larger, closer fibers.";
		ui_min = 0.25; ui_max = 8; ui_step = 0.05;
	> = 1.0;

	uniform bool EnableAdaptiveDepth<
		ui_type = "checkbox";
		ui_category = "Depth Settings";
		ui_category_toggle = true;
		ui_label = "Depth Aware Strength";
		ui_tooltip = "Enable depth-based Oilify strength. The controls below appear only while this option is enabled.";
	> = false;

	uniform float DepthNearStrength<
		ui_category = "Depth Settings";
		ui_type = "slider";
		ui_label = "Near Plane Effect Strength";
		ui_min = 0; ui_max = 1; ui_step = 0.01;
	> = 1.0;

	uniform float DepthFarStrength<
		ui_category = "Depth Settings";
		ui_type = "slider";
		ui_label = "Far Plane Effect Strength";
		ui_min = 0; ui_max = 1; ui_step = 0.01;
	> = 1.0;

	uniform float DepthBoundaryDistance<
		ui_category = "Depth Settings";
		ui_type = "slider";
		ui_label = "Near/Far Boundary Distance";
		ui_tooltip = "Approximate scene distance at the center of a broad 120-meter foreground/background transition. The Oilify strength changes gradually over many tens of meters.";
		ui_min = 1; ui_max = 500; ui_step = 1;
	> = 40;

	uniform float Sharpness<
		ui_type = "slider";
		ui_label = "Sharpness";
		ui_tooltip = "Higher settings result in a sharper image, while lower values give the\n"
					"image a more simplified look.";
		ui_min = 0; ui_max = 1;
		ui_step = 0.001;
	> = 1;

	uniform float Tuning<
		ui_type = "slider";
		ui_label = "Anistropy Tuning";
		ui_tooltip = "Adjusts how elliptical the sampling can become with anisotropy\n"
					"Smaller numbers mean more elliptical. (Use this if the shader looks stretched)";
		ui_min = 0; ui_max = 4;
	> = 2;

	uniform float Scale<
		ui_type = "slider";
		ui_label = "Scale";
		ui_tooltip = "Similar to size it raises the range the effect is applied over, \n"
					"however, the number of samples remains unchanged resulting in a less, \n"
					"detailed image.";
		ui_min = 1; ui_max = 4;
	> = 1;

	// Vertex shader generating a triangle covering the entire screen
	void PostProcessVS(in uint id : SV_VertexID, out float4 position : SV_Position, out float2 texcoord : TEXCOORD)
	{
		texcoord.x = (id == 2) ? 2.0 : 0.0;
		texcoord.y = (id == 1) ? 2.0 : 0.0;
		position = float4(texcoord * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
	}


	float3 ApplyPosterization(float3 color)
	{
		float levels = max(PosterizationLevels, 2.0);
		return floor(saturate(color) * levels + 0.5) / levels;
	}

	// --- Canvas texture -----------------------------------------------------
	// No periodic sine weave is used here. The texture is made from anisotropic
	// noise ridges with domain warping, producing broken, irregular fibers instead
	// of a geometric grid. It is rendered into a quarter-resolution cache.
	float CanvasHash21(float2 p)
	{
		p = frac(p * float2(0.1031, 0.1030));
		p += dot(p, p.yx + 33.33);
		return frac((p.x + p.y) * p.x * p.y);
	}

	float CanvasValueNoise(float2 p)
	{
		float2 i = floor(p);
		float2 f = frac(p);
		f = f * f * (3.0 - 2.0 * f);

		float a = CanvasHash21(i);
		float b = CanvasHash21(i + float2(1.0, 0.0));
		float c = CanvasHash21(i + float2(0.0, 1.0));
		float d = CanvasHash21(i + float2(1.0, 1.0));
		return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
	}

	float2 CanvasRotate(float2 p, float c, float sn)
	{
		return float2(p.x * c - p.y * sn, p.x * sn + p.y * c);
	}

	float CanvasFiberField(float2 p, float angleSign, float strength, float seed)
	{
		// Slightly tilted axes prevent perfect screen-aligned weave.
		float2 q = CanvasRotate(p, 0.9902681, 0.1391731 * angleSign);
		q = float2(q.x * 0.075, q.y * 1.65);
		q += float2(seed * 13.7, seed * -8.9);

		float base = CanvasValueNoise(q);
		float detail = CanvasValueNoise(q * float2(1.8, 0.62) + 17.3);
		float breakup = CanvasValueNoise(q * float2(0.24, 0.16) + 41.7);

		// Thresholded anisotropic noise gives narrow, ragged fiber ridges.
		float ridge = smoothstep(0.48, 0.77, base);
		ridge *= lerp(0.35, 1.0, smoothstep(0.20, 0.72, breakup));
		ridge *= 0.72 + 0.28 * detail;
		return ridge * strength;
	}

	float BuildCanvasRelief(float2 texcoord)
	{
		float2 p = texcoord * float2(BUFFER_WIDTH * 0.25, BUFFER_HEIGHT * 0.25);
		p *= max(CanvasScale, 0.001) * 0.62;

		// Large organic warp keeps the fiber paths irregular along their length.
		float warpX = CanvasValueNoise(p * 0.065 + float2(19.4, -8.2));
		float warpY = CanvasValueNoise(p * 0.065 + float2(-11.6, 27.7));
		p += (float2(warpX, warpY) - 0.5) * 2.4;

		float fibersA = CanvasFiberField(p, 1.0, 1.00, 0.17);
		float fibersB = CanvasFiberField(p + float2(23.8, -16.2), -1.0, 0.82, 0.61);

		// Sparse stray fibers break up any residual periodicity.
		float2 r = CanvasRotate(p * 0.90, 0.8011, 0.5985);
		r = float2(r.x * 0.10, r.y * 1.15);
		float stray = smoothstep(0.67, 0.87, CanvasValueNoise(r + 53.7)) * 0.15;

		float fibers = max(max(fibersA, fibersB), stray);

		// Underlying canvas body plus a very small amount of fiber grain.
		float broad = CanvasValueNoise(p * 0.16 + 71.4) - 0.5;
		float micro = CanvasValueNoise(p * 1.9 + 91.8) - 0.5;

		float relief = fibers * 0.23 + broad * 0.060 + micro * 0.015;
		return saturate(0.5 + relief);
	}

	void CanvasCacheAPS(float4 vpos : SV_POSITION, float2 texcoord : TEXCOORD, out float4 cache : SV_TARGET0)
	{
		if (CanvasFrameCount % CANVAS_UPDATE_INTERVAL == 0)
		{
			if (EnableCanvas)
				cache = float4(BuildCanvasRelief(texcoord), 0.0, 0.0, 1.0);
			else
				cache = float4(0.5, 0.0, 0.0, 1.0);
		}
		else
		{
			cache = tex2D(sCanvasCacheB, texcoord);
		}
	}

	void CanvasCacheBPS(float4 vpos : SV_POSITION, float2 texcoord : TEXCOORD, out float4 cache : SV_TARGET0)
	{
		// Always mirror A after it has either been generated or copied from B.
		cache = tex2D(sCanvasCacheA, texcoord);
	}

	float3 ApplyCanvas(float3 color, float2 texcoord)
	{
		if (!EnableCanvas || CanvasStrength <= 0.0001)
			return color;

		float4 cacheA = tex2D(sCanvasCacheA, texcoord);
		float relief = (cacheA.r - 0.5) * 2.0;

		// Alpha is an initialization marker. A newly allocated cache is neutralized
		// until the first scheduled generation frame.
		if (cacheA.a < 0.5)
			return color;

		float multiplier = 1.0 + relief * saturate(CanvasStrength);
		return max(color * multiplier, 0.0);
	}

	#ifndef RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN
		#define RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN 0
	#endif
	#ifndef RESHADE_DEPTH_INPUT_IS_REVERSED
		#define RESHADE_DEPTH_INPUT_IS_REVERSED 1
	#endif
	#ifndef RESHADE_DEPTH_INPUT_IS_MIRRORED
		#define RESHADE_DEPTH_INPUT_IS_MIRRORED 0
	#endif
	#ifndef RESHADE_DEPTH_INPUT_IS_LOGARITHMIC
		#define RESHADE_DEPTH_INPUT_IS_LOGARITHMIC 0
	#endif
	#ifndef RESHADE_DEPTH_MULTIPLIER
		#define RESHADE_DEPTH_MULTIPLIER 1
	#endif
	#ifndef RESHADE_DEPTH_LINEARIZATION_FAR_PLANE
		#define RESHADE_DEPTH_LINEARIZATION_FAR_PLANE 1000.0
	#endif
	#ifndef RESHADE_DEPTH_INPUT_Y_SCALE
		#define RESHADE_DEPTH_INPUT_Y_SCALE 1
	#endif
	#ifndef RESHADE_DEPTH_INPUT_X_SCALE
		#define RESHADE_DEPTH_INPUT_X_SCALE 1
	#endif
	#ifndef RESHADE_DEPTH_INPUT_Y_OFFSET
		#define RESHADE_DEPTH_INPUT_Y_OFFSET 0
	#endif
	#ifndef RESHADE_DEPTH_INPUT_Y_PIXEL_OFFSET
		#define RESHADE_DEPTH_INPUT_Y_PIXEL_OFFSET 0
	#endif
	#ifndef RESHADE_DEPTH_INPUT_X_OFFSET
		#define RESHADE_DEPTH_INPUT_X_OFFSET 0
	#endif
	#ifndef RESHADE_DEPTH_INPUT_X_PIXEL_OFFSET
		#define RESHADE_DEPTH_INPUT_X_PIXEL_OFFSET 0
	#endif

	// Convert ReShade depth into approximate camera distance in scene units.
	float GetDepthDistance(float2 texcoord)
	{
	#if RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN
		texcoord.y = 1.0 - texcoord.y;
	#endif
	#if RESHADE_DEPTH_INPUT_IS_MIRRORED
		texcoord.x = 1.0 - texcoord.x;
	#endif

		texcoord.x /= RESHADE_DEPTH_INPUT_X_SCALE;
		texcoord.y /= RESHADE_DEPTH_INPUT_Y_SCALE;

	#if RESHADE_DEPTH_INPUT_X_PIXEL_OFFSET
		texcoord.x -= RESHADE_DEPTH_INPUT_X_PIXEL_OFFSET * BUFFER_RCP_WIDTH;
	#else
		texcoord.x -= RESHADE_DEPTH_INPUT_X_OFFSET / 2.000000001;
	#endif

	#if RESHADE_DEPTH_INPUT_Y_PIXEL_OFFSET
		texcoord.y += RESHADE_DEPTH_INPUT_Y_PIXEL_OFFSET * BUFFER_RCP_HEIGHT;
	#else
		texcoord.y += RESHADE_DEPTH_INPUT_Y_OFFSET / 2.000000001;
	#endif

		float depth = tex2Dlod(sDepthBuffer, float4(texcoord, 0, 0)).x * RESHADE_DEPTH_MULTIPLIER;

	#if RESHADE_DEPTH_INPUT_IS_LOGARITHMIC
		const float C = 0.01;
		depth = (exp(depth * log(C + 1.0)) - 1.0) / C;
	#endif

	#if RESHADE_DEPTH_INPUT_IS_REVERSED
		depth = 1.0 - depth;
	#endif

		const float N = 1.0;
		const float farPlane = max(float(RESHADE_DEPTH_LINEARIZATION_FAR_PLANE), N + 1e-3);
		depth /= farPlane - depth * (farPlane - N);
		depth = saturate(depth);
		return depth * farPlane;
	}

	// Depth changes the FINAL amount of the Oilify result, rather than changing
	// the sampling radius. This prevents a moving hard-looking spatial boundary.
	float GetDepthStrength(float2 texcoord)
	{
		float nearStrength = saturate(DepthNearStrength);
		float farStrength = saturate(DepthFarStrength);
		float distanceMeters = GetDepthDistance(texcoord);

		// DepthBoundaryDistance is the center of the transition. The transition
		// is intentionally 120 m wide so the effect rolls gradually over many tens of meters.
		const float halfTransitionMeters = 60.0;
		float transition = smoothstep(
			max(0.0, DepthBoundaryDistance - halfTransitionMeters),
			DepthBoundaryDistance + halfTransitionMeters,
			distanceMeters);
		// A second smoothstep keeps the middle of the transition from reading as
		// a thin wall when foreground and background strengths differ strongly.
		transition = smoothstep(0.0, 1.0, transition);

		return lerp(nearStrength, farStrength, transition);
	}

	float3 GetOilifyInput(float2 uv)
	{
		return tex2D(sOilifyInput, uv).rgb;
	}

	void PrepareInputPS(float4 vpos : SV_POSITION, float2 texcoord : TEXCOORD, out float3 color : SV_TARGET0)
	{
		color = tex2D(sBackBuffer, texcoord).rgb;

		// These effects intentionally happen BEFORE any Oilify processing.
		if (EnablePosterization)
			color = ApplyPosterization(color);

		if (EnableCanvas)
			color = ApplyCanvas(color, texcoord);
	}

	void AnisotropyPS(float4 vpos : SV_POSITION, float2 texcoord : TEXCOORD,
		out float4 anisotropyData : SV_TARGET0, out float4 originalOutput : SV_TARGET1)
	{
		float3 inputColor = GetOilifyInput(texcoord);
		float3 center = inputColor * 255;
		originalOutput = float4(inputColor, 1.0);
		float3 dx = center * GAUSSIAN_WEIGHTS[2];
		float3 dy = dx;
		
		[unroll]
		for(int i = 0; i < 5; i++)
		{
			if (i == 2) i++;
			float3 offsets = float3(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT, 0) * GAUSSIAN_OFFSETS[i];
			dx += GetOilifyInput(texcoord + offsets.xz) * GAUSSIAN_WEIGHTS[i] * 255;
			dy += GetOilifyInput(texcoord + offsets.zy) * GAUSSIAN_WEIGHTS[i] * 255;
		}
		dx = ddx(dx);
		dy = ddy(dy);
		
		float e = dot(dx, dx);
		float f = dot(dx, dy);
		float g = dot(dy, dy);
		float root = sqrt((e-g) * (e-g) + 4 * f * f);
		float2 eigenvalues = float2(e + g + root, e + g - root) / 2;
		
		float2 t;
		[flatten]
		if(any(abs(float2(eigenvalues.x - e, -f)) > 1e-15))
		{
			t = (normalize((float2(eigenvalues.x - e, -f))));
		}
		else
			t = float2(1, 0);
			
		float anisotropy = abs((eigenvalues.y - eigenvalues.x) / (eigenvalues.x + eigenvalues.y));
		anisotropy *= anisotropy;
		anisotropy = saturate(anisotropy);
		anisotropy = max(anisotropy, 1e-15);
		anisotropyData.xyz = float3(t, anisotropy);
		anisotropyData.w = 1;
	}
			

	void KuwaharaPS(float4 vpos : SV_POSITION, float2 texcoord : TEXCOORD, out float3 kuwahara : SV_TARGET0)
	{
		float sharpnessMultiplier = max(1023 * pow(( 2 * Sharpness / 3) + 0.333333, 4), 1e-10);
		float3 sum[6];
		float3 squaredSum[6];
		float sampleCount[6];

		// The center pixel is shared by all six sectors. Cache it once instead of
		// fetching it six times from the input texture.
		float3 centerColor = GetOilifyInput(texcoord) * sharpnessMultiplier;
		[unroll]
		for (int k = 0; k < 6; ++k)
		{
			sum[k] = centerColor;
			squaredSum[k] = centerColor * centerColor;
			sampleCount[k] = 1.0;
		}

		// The radius test only needs the squared length, which avoids a sqrt per
		// candidate sample while producing the same inclusion boundary.
		float2 radiusVector = float2((float(OILIFY_SIZE) / 2), (float(OILIFY_SIZE) / 4));
		float radiusSquared = dot(radiusVector, radiusVector);
		
		float3 anistropyData = tex2D(sAnisotropy, texcoord).xyz;
		float2 t = anistropyData.xy;
		float anisotropy = anistropyData.z;
		float tuning = exp2(Tuning - 1);
		float2x2 tuningMatrix = float2x2(tuning / (anisotropy + tuning), 0,
								0, (tuning + anisotropy) / tuning);
		float2x2 rotationMatrix = float2x2(t.x, -t.y, t.y, t.x);
		float2x2 offsetMatrix = mul(rotationMatrix, tuningMatrix);
		[unroll]
		for(int i = -(OILIFY_SIZE / 2); i < ((OILIFY_SIZE + 1) / 2); i++)
		{
			[unroll]
			for(int j = -(OILIFY_SIZE / 2); j < ((OILIFY_SIZE + 1) / 2); j++)
			{
				float2 offset = float2(i, j);
				if(abs(j) % 2 != 0)
				{
					offset.y -= 0.5;
				}
				
				if(all(int2(i, j) != 0) && dot(offset, offset) <= radiusSquared)
				{
					float angle = atan2(offset.x, offset.y) + PI;
					if(angle > 5.75958653158)
					{
						angle -= 2 * PI;
					}
					float sectorOffset = (float((angle * 6) / PI) + 1) / 2;
					int sector = floor(sectorOffset);
					sectorOffset -= float(sector);
					offset *= float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT) * Scale;
					offset = mul(offset, offsetMatrix);
					float3 color = GetOilifyInput(texcoord + offset) * sharpnessMultiplier;
					sum[sector] += color;
					squaredSum[sector] += color * color;
					sampleCount[sector]++;
				}
			}
		}
		
		float3 weightedSum = 0;
		float3 weightSum = 0;
		[unroll]
		for(int i = 0; i < 6; i++)
		{
			float invCount = rcp(sampleCount[i]);
			float3 mean = sum[i] * invCount;
			float3 variance = squaredSum[i] - (sum[i] * sum[i] * invCount);
			variance *= rcp(sampleCount[0]);
			float rootVariance = sqrt(max(dot(variance, float3(0.299, 0.587, 0.114)), 1e-5));
			float x2 = rootVariance * rootVariance;
			float x4 = x2 * x2;
			float x8 = x4 * x4;
			float weight = rcp(1.0 + x8);
			weightedSum += mean * weight;
			weightSum += weight;
		}
		kuwahara = ((weightedSum) / weightSum) / sharpnessMultiplier;
	}

	void CompositePS(float4 vpos : SV_POSITION, float2 texcoord : TEXCOORD, out float3 outputColor : SV_TARGET0)
	{
		float3 filtered = tex2D(sOilifyResult, texcoord).rgb;

		[branch]
		if (!EnableAdaptiveDepth || !HasDepth)
		{
			outputColor = filtered;
			return;
		}

		float3 original = tex2D(sOriginalInput, texcoord).rgb;
		float strength = GetDepthStrength(texcoord);
		outputColor = lerp(original, filtered, strength);
	}

	technique Oilify<ui_tooltip = "Oilify is a revised version of the anisotropic kuwahara filter,\n"
							  "which is used to create a painterly effect.\n\n"
							  "Part of Insane Shaders\n"
							  "By: Lord of Lunacy\n\n"
							  "OILIFY_SIZE: Changes the size of the filter used.\n"
							  "OILIFY_ITERATIONS: Ranges from 1 to 8.";>
	{


	
		// Canvas cache. The expensive procedural map is generated only once every
		// eight frames; both quarter-resolution targets are then kept synchronized.
		pass CanvasCacheA
		{
			VertexShader = PostProcessVS;
			PixelShader = CanvasCacheAPS;
			RenderTarget = CanvasCacheA;
			ClearRenderTargets = false;
		}

		pass CanvasCacheB
		{
			VertexShader = PostProcessVS;
			PixelShader = CanvasCacheBPS;
			RenderTarget = CanvasCacheB;
			ClearRenderTargets = false;
		}

		pass
		{
			VertexShader = PostProcessVS;
			PixelShader = PrepareInputPS;
			RenderTarget0 = OilifyInput;
		}
		
		pass
		{
			VertexShader = PostProcessVS;
			PixelShader = AnisotropyPS;
			RenderTarget0 = Anisotropy;
			RenderTarget1 = OriginalInput;
		}
		
		pass
		{
			VertexShader = PostProcessVS;
			PixelShader = KuwaharaPS;
			RenderTarget0 = OilifyResult;
		}
#if OILIFY_ITERATIONS > 1
	OILIFY_PASS
#endif
#if OILIFY_ITERATIONS > 2
	OILIFY_PASS
#endif
#if OILIFY_ITERATIONS > 3
	OILIFY_PASS
#endif
#if OILIFY_ITERATIONS > 4
	OILIFY_PASS
#endif
#if OILIFY_ITERATIONS > 5
	OILIFY_PASS
#endif
#if OILIFY_ITERATIONS > 6
	OILIFY_PASS
#endif
#if OILIFY_ITERATIONS > 7
	OILIFY_PASS
#endif

		pass
		{
			VertexShader = PostProcessVS;
			PixelShader = CompositePS;
		}
	}
}

